# AI Mom — required secrets, explained
#
# This file is just a checklist. The Flutter app does not read a .env
# file directly — it reads these same values from config/local.json
# (see config/local.json.example) at build/run time. The three marked
# "EDGE FUNCTION SECRET" go into Supabase instead (command below), not
# into the app.
#
# Never fill in real values here and commit them. This file stays
# empty on purpose — copy it, fill in the copy, keep the copy out of git.

# ── Supabase (backend: database + login) ────────────────────────────
# Get these from your Supabase project: Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── RevenueCat (subscriptions / in-app purchases) ────────────────────
# Get these from your RevenueCat project: Project settings > API keys
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=

# ── Google Sign-In ────────────────────────────────────────────────────
# The "Web" OAuth client ID from Google Cloud Console (Credentials page)
GOOGLE_WEB_CLIENT_ID=

# ── EDGE FUNCTION SECRET: Google Gemini (Mom's chat brain) ───────────
# Free, no credit card needed. Get this from aistudio.google.com > Get API key
# Set it on Supabase, not in the app:
#   supabase secrets set GEMINI_API_KEY=your-key-here
# Leave unset and chat still works — it just replies with an obvious
# placeholder instead of a real AI response (see README.md).
GEMINI_API_KEY=

# ── EDGE FUNCTION SECRET: RevenueCat webhook ─────────────────────────
# A password you make up yourself (any long random string). Put the
# same value in two places: here, and in RevenueCat's webhook settings
# as the Authorization header. Set it on Supabase:
#   supabase secrets set REVENUECAT_WEBHOOK_SECRET=your-made-up-value
REVENUECAT_WEBHOOK_SECRET=

# ── Provided automatically by Supabase — you don't set these ────────
# SUPABASE_SERVICE_ROLE_KEY is injected into edge functions by Supabase
# itself. Never put this one in the app or anywhere a user's phone can
# read it — it can bypass all the security rules.
